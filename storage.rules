rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Function to check if it's the official super admin emails
    function isSuperAdminEmail() {
      return request.auth != null && (request.auth.token.email == 'manavsamantasangthan@gmail.com' || request.auth.token.email == 'gulfamrpf@gmail.com');
    }

    // Anyone can view uploaded images
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Admins can upload anything (logos, etc)
    match /settings/{imageId} {
      allow write: if isAdmin() || isSuperAdminEmail();
    }
    
    match /profiles/{imageId} {
      allow write: if isAdmin() || isSuperAdminEmail();
    }
    
    // Users can upload their own profile pictures
    match /users/{userId}/{imageId} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Fallback for any other uploads
    match /{allPaths=**} {
      allow write: if isAdmin() || isSuperAdminEmail() || request.auth != null;
    }
  }
}
